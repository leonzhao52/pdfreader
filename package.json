{
  "name": "pdfreader",
  "version": "0.1.0",
  "description": "轻量级 Windows 桌面 PDF 阅读器 - 专注阅读体验",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder --win"
  },
  "author": "用户",
  "license": "MIT",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^26.18.0"
  },
  "dependencies": {
    "electron-store": "^8.2.0",
    "pdfjs-dist": "^3.11.174"
  },
  "build": {
    "appId": "com.example.pdfreader",
    "productName": "PDFReader",
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    }
  }
}
